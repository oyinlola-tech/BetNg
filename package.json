{
  "name": "betng",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BetNG — a virtual football platform simulation. Portfolio project; not a real betting service.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "zudojs": {
    "projectType": "backend",
    "architecture": "microservice",
    "features": [
      "database",
      "observability",
      "security"
    ]
  },
  "scripts": {
    "build": "pnpm -r run build",
    "db:bootstrap": "bash scripts/db-bootstrap.sh",
    "db:generate": "pnpm -r --filter './apps/services/*' run db:generate",
    "db:migrate": "pnpm -r --filter './apps/services/*' run db:migrate",
    "db:migrate:dev": "pnpm -r --filter './apps/services/*' run db:migrate:dev",
    "dev": "node scripts/dev.mjs",
    "dev:admin": "pnpm --filter @betng/admin dev",
    "dev:mobile": "pnpm --filter @betng/mobile start",
    "dev:py": "node scripts/dev.mjs --py-only",
    "dev:shop": "pnpm --filter @betng/shop dev",
    "dev:ts": "node scripts/dev.mjs --ts-only",
    "dev:tv": "pnpm --filter @betng/tv dev",
    "dev:web": "pnpm --filter @betng/web dev",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "infra:logs": "docker compose -f infrastructure/docker/docker-compose.yml logs -f",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "lint": "node tools/lint/node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node tools/lint/node_modules/eslint/bin/eslint.js . --fix",
    "lint:frontend": "node tools/lint/node_modules/eslint/bin/eslint.js apps/web apps/tv apps/shop apps/admin apps/mobile packages/ui-web packages/ui-core packages/mock-data packages/client-sdk packages/contracts packages/design-tokens packages/brand",
    "py:check": "bash scripts/python-check.sh",
    "py:install": "bash scripts/python-install.sh",
    "py:test": "bash scripts/python-test.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "verify": "bash scripts/verify.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  }
}
