# Local development defaults only; copy to `.env`. No real credentials.

NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
ANALYTICS_PORT=3009

# SELECT-only login; analytics owns no schema.
ANALYTICS_DATABASE_URL=postgresql://betng_analytics:betng_analytics_local@localhost:55432/betng

# IANA zone that report days and hours are cut in.
ANALYTICS_REPORT_TIMEZONE=UTC
