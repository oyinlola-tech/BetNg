# BetNG simulation service: local development defaults. Copy to `.env`; never commit real secrets.

NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
SIMULATION_PORT=3005

# Required. Login `betng_simulation` owns the `simulation` schema and can only read the others.
# `/ready` probes it. Export it: the kit reads it from the process environment, not from `.env`.
SIMULATION_DATABASE_URL=postgresql://betng_simulation:betng_simulation_local@localhost:55432/betng

# Tests use the `betng_test` database; override with this if yours lives elsewhere.
# SIMULATION_TEST_DATABASE_URL=postgresql://betng_simulation:betng_simulation_local@localhost:55432/betng_test

# Audit entries go to identity over RPC (`identity.recordAudit`).
IDENTITY_SERVICE_URL=http://localhost:3010
SERVICE_TIMEOUT_MS=5000

# Shared service-to-service secret. Guards `/rpc`, `/internal/*` and the actor headers.
# Unset means no check in development and test; mandatory in production.
INTERNAL_SERVICE_TOKEN=betng-local-development-internal-token

# Keys every match seed (HMAC-SHA256), so public inputs cannot predict a result.
# Production refuses to start if it is unset, under 32 characters or this placeholder.
# Unset elsewhere falls back to un-keyed sha256 seeds and logs a warning at start-up.
SIMULATION_SEED_SECRET=betng-local-development-seed-secret
