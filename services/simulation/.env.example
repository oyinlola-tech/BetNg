# ---------------------------------------------------------------------------
# BetNG simulation service — development environment template
#
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.
# Every value here is a local development default for a simulation-only
# portfolio project. There are no real credentials in this file.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
SIMULATION_PORT=3005

# The simulation service owns no database and no cache: it computes a result
# from the teams it is given. It therefore declares no DATABASE_URL, and
# `GET /ready` reports no dependencies rather than inventing one.

# Where the rest of the platform lives, read by anything that needs to call
# back out. Never hard-code these in application logic.
MATCH_SERVICE_URL=http://localhost:3001
ODDS_SERVICE_URL=http://localhost:3006
RISK_SERVICE_URL=http://localhost:3007
SERVICE_TIMEOUT_MS=5000
