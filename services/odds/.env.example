# Local development defaults only; copy to `.env`. Never commit real secrets.

NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
ODDS_PORT=3006

# Required. The odds login owns the `odds` schema and can only read the others.
ODDS_DATABASE_URL=postgresql://betng_odds:betng_odds_local@localhost:55432/betng

# simulation is required (`/ready` probes it; without it publishing answers
# ODDS_UNAVAILABLE). An admin action fails if identity cannot write its audit.
SIMULATION_SERVICE_URL=http://localhost:3005
IDENTITY_SERVICE_URL=http://localhost:3010
EVENT_SERVICE_URL=http://localhost:3008
SERVICE_TIMEOUT_MS=5000
