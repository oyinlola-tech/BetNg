# ---------------------------------------------------------------------------
# BetNG odds service — development environment template
#
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.
# Every value here is a local development default for a simulation-only
# portfolio project. There are no real credentials in this file.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
ODDS_PORT=3006

# The odds service owns no database in this phase: it is handed probabilities
# and returns prices. It therefore declares no DATABASE_URL, and `GET /ready`
# reports no dependencies rather than inventing one.

# Where the rest of the platform lives. Never hard-code these in application
# logic — the odds service reads probabilities from simulation over RPC.
SIMULATION_SERVICE_URL=http://localhost:3005
MATCH_SERVICE_URL=http://localhost:3001
RISK_SERVICE_URL=http://localhost:3007
SERVICE_TIMEOUT_MS=5000
