# BetNG risk service: local development defaults. Copy to `.env`; never commit real secrets.

NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
RISK_PORT=3007

# Login `betng_risk` owns schema `risk` and reads the others. Migrations run at startup.
RISK_DATABASE_URL=postgresql://betng_risk:betng_risk_local@localhost:55432/betng

# Limit changes are audited through `identity.recordAudit` and refused if that fails.
IDENTITY_SERVICE_URL=http://localhost:3010
SERVICE_TIMEOUT_MS=5000

# Service-to-service secret required on `/rpc`, `/internal/*` and actor headers.
# Unset means no check outside production; use the root `.env` value.
INTERNAL_SERVICE_TOKEN=betng-local-development-internal-token

# Deliberately no simulation URL: risk has no channel to it.

# RISK_ALERT signals go to the event service's `risk` channel.
EVENT_SERVICE_URL=http://localhost:3008

# Limits are cached only while the change listener is connected; 0 reads them per decision.
RISK_LIMITS_CACHE_TTL_MS=5000
# Exposure alert sweep (80% / 100% of market and match limits); 0 disables.
RISK_ALERT_INTERVAL_MS=10000

# Shared kit: per-calling-service limit on POST /rpc (0 disables) and per-peer circuit breaker.
RPC_RATE_LIMIT_PER_SECOND=1000
RPC_RATE_LIMIT_BURST=2000
RPC_BREAKER_FAILURE_THRESHOLD=5
RPC_BREAKER_RESET_MS=10000
