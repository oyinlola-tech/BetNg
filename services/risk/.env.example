# ---------------------------------------------------------------------------
# BetNG risk service — development environment template
#
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.
# Every value here is a local development default for a simulation-only
# portfolio project. There are no real credentials in this file.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0
RISK_PORT=3007

# The risk service owns no database in this phase: it is handed a market's
# accepted stakes and returns an analysis. It therefore declares no
# DATABASE_URL, and `GET /ready` reports no dependencies rather than
# inventing one.

# The risk service is INTERNAL. The gateway forwards nothing to it, and it
# must not be exposed on a public network. See docs/architecture.md.
BETTING_SERVICE_URL=http://localhost:3002
SERVICE_TIMEOUT_MS=5000
