{
  "name": "@betng/service-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The shared ZudoJS service bootstrap for BetNG TypeScript services: configuration, structured logging, request correlation, the error envelope, health probes and the service-to-service client.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@betng/contracts": "workspace:*",
    "@zudojs/config": "1.2.0",
    "@zudojs/constants": "1.1.1",
    "@zudojs/errors": "1.2.0",
    "@zudojs/http": "1.3.0",
    "@zudojs/logger": "1.3.0",
    "@zudojs/rpc": "1.3.0",
    "@zudojs/validation": "1.0.3",
    "pg": "^8.23.0",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "typescript": "7.0.2"
  }
}
