# ---------------------------------------------------------------------------
# BetNG — development environment template
#
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.
# Every value here is a local development default for a simulation-only
# portfolio project. There are no real credentials in this file.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0

# --- Service ports ---------------------------------------------------------
GATEWAY_PORT=3000
MATCH_PORT=3001
BETTING_PORT=3002
WALLET_PORT=3003
SETTLEMENT_PORT=3004
SIMULATION_PORT=3005
ODDS_PORT=3006
RISK_PORT=3007

# --- Service discovery -----------------------------------------------------
# Never hard-code these in application logic; always read them from config.
GATEWAY_SERVICE_URL=http://localhost:3000
MATCH_SERVICE_URL=http://localhost:3001
BETTING_SERVICE_URL=http://localhost:3002
WALLET_SERVICE_URL=http://localhost:3003
SETTLEMENT_SERVICE_URL=http://localhost:3004
SIMULATION_SERVICE_URL=http://localhost:3005
ODDS_SERVICE_URL=http://localhost:3006
RISK_SERVICE_URL=http://localhost:3007

# How long a service waits on another service before giving up (ms).
SERVICE_TIMEOUT_MS=5000

# --- PostgreSQL ------------------------------------------------------------
# One database per owning service. A service connects only to its own.
# The credentials below belong to the local docker-compose container only.
POSTGRES_USER=betng
POSTGRES_PASSWORD=betng_local_dev
POSTGRES_HOST=localhost
# 5433, not 5432: the compose stack avoids clashing with a PostgreSQL a
# developer may already be running on the default port.
POSTGRES_PORT=5433

MATCH_DATABASE_URL=postgresql://betng:betng_local_dev@localhost:5433/betng_match
BETTING_DATABASE_URL=postgresql://betng:betng_local_dev@localhost:5433/betng_betting
WALLET_DATABASE_URL=postgresql://betng:betng_local_dev@localhost:5433/betng_wallet
SETTLEMENT_DATABASE_URL=postgresql://betng:betng_local_dev@localhost:5433/betng_settlement

# --- Redis -----------------------------------------------------------------
# Reserved for caching, short-lived match state and coordination.
REDIS_URL=redis://localhost:6380
