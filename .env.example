# ---------------------------------------------------------------------------
# BetNG — development environment template
#
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.
# Every value here is a local development default for a simulation-only
# portfolio project. There are no real credentials in this file.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0

# --- Service ports ---------------------------------------------------------
GATEWAY_PORT=3000
MATCH_PORT=3001
BETTING_PORT=3002
WALLET_PORT=3003
SETTLEMENT_PORT=3004
SIMULATION_PORT=3005
ODDS_PORT=3006
RISK_PORT=3007
EVENT_PORT=3008
ANALYTICS_PORT=3009
IDENTITY_PORT=3010

# --- Service discovery -----------------------------------------------------
# Never hard-code these in application logic; always read them from config.
GATEWAY_SERVICE_URL=http://localhost:3000
MATCH_SERVICE_URL=http://localhost:3001
BETTING_SERVICE_URL=http://localhost:3002
WALLET_SERVICE_URL=http://localhost:3003
SETTLEMENT_SERVICE_URL=http://localhost:3004
SIMULATION_SERVICE_URL=http://localhost:3005
ODDS_SERVICE_URL=http://localhost:3006
RISK_SERVICE_URL=http://localhost:3007
EVENT_SERVICE_URL=http://localhost:3008
ANALYTICS_SERVICE_URL=http://localhost:3009
IDENTITY_SERVICE_URL=http://localhost:3010

# How long a service waits on another service before giving up (ms).
SERVICE_TIMEOUT_MS=5000

# --- Internal trust -----------------------------------------------------------
# Proves a call came from inside the platform. RPC endpoints and the gateway's
# actor headers are honoured only with it. This value is a local development
# placeholder: production refuses to start with it. Without any token, services start (and trust
# unauthenticated internal calls) only when NODE_ENV is exactly development or test.
INTERNAL_SERVICE_TOKEN=betng-local-development-internal-token

# Keys every match seed (HMAC), so a result cannot be computed from a match id and
# the source code before betting closes. Local placeholder: production refuses it.
SIMULATION_SEED_SECRET=betng-local-development-seed-secret

# Browser origins the gateway answers (comma separated). Never "*". Production refuses to start unless this lists
# https origins only, none of them local (localhost, 127.x, *.localhost).
CORS_ORIGINS=http://localhost:4200,http://localhost:4300,http://localhost:4400,http://localhost:4500,http://localhost:8081

# --- PostgreSQL ------------------------------------------------------------
# One authoritative database, `betng`, with one schema and one login per
# owning service. A service writes only its own schema and may read the
# others (see infrastructure/postgres/bootstrap.sql and docs/architecture.md).
#
# These belong to a local container holding simulated data. They are not
# secrets and nothing here is reachable beyond this machine.
POSTGRES_USER=betng
POSTGRES_PASSWORD=betng_local_dev
POSTGRES_HOST=localhost
# 55432, not 5432: the compose stack avoids clashing with any PostgreSQL a
# developer already runs. Change it here and in the compose file together.
POSTGRES_PORT=55432

# Prisma-managed services. `schema` selects the service's schema.
MATCH_DATABASE_URL=postgresql://betng_match:betng_match_local@localhost:55432/betng?schema=match
BETTING_DATABASE_URL=postgresql://betng_betting:betng_betting_local@localhost:55432/betng?schema=betting
WALLET_DATABASE_URL=postgresql://betng_wallet:betng_wallet_local@localhost:55432/betng?schema=wallet
SETTLEMENT_DATABASE_URL=postgresql://betng_settlement:betng_settlement_local@localhost:55432/betng?schema=settlement
IDENTITY_DATABASE_URL=postgresql://betng_identity:betng_identity_local@localhost:55432/betng?schema=identity

# Python services. Their role's search_path is already their schema.
SIMULATION_DATABASE_URL=postgresql://betng_simulation:betng_simulation_local@localhost:55432/betng
ODDS_DATABASE_URL=postgresql://betng_odds:betng_odds_local@localhost:55432/betng
RISK_DATABASE_URL=postgresql://betng_risk:betng_risk_local@localhost:55432/betng
ANALYTICS_DATABASE_URL=postgresql://betng_analytics:betng_analytics_local@localhost:55432/betng

# Prisma's `migrate dev` diffs the schema against a throwaway database.
# Only `migrate dev` uses these; `migrate deploy` does not.
MATCH_SHADOW_DATABASE_URL=postgresql://betng_match:betng_match_local@localhost:55432/betng_match_shadow
BETTING_SHADOW_DATABASE_URL=postgresql://betng_betting:betng_betting_local@localhost:55432/betng_betting_shadow
WALLET_SHADOW_DATABASE_URL=postgresql://betng_wallet:betng_wallet_local@localhost:55432/betng_wallet_shadow
SETTLEMENT_SHADOW_DATABASE_URL=postgresql://betng_settlement:betng_settlement_local@localhost:55432/betng_settlement_shadow
IDENTITY_SHADOW_DATABASE_URL=postgresql://betng_identity:betng_identity_local@localhost:55432/betng_identity_shadow

# --- Redis -----------------------------------------------------------------
# Reserved for caching, short-lived match state and coordination.
REDIS_URL=redis://localhost:56379

# --- Platform behaviour ------------------------------------------------------
# Defaults match packages/ui-core/src/timing.ts; the clients derive the match clock from them.
MATCH_SECONDS_PER_MINUTE=2
MATCH_HALF_TIME_SECONDS=15
BETTING_CLOSE_LEAD_SECONDS=10
ROUND_CYCLE_SECONDS=240
UPCOMING_ROUNDS=3
SCHEDULER_ENABLED=true

# Local development only. The seed creates the demo accounts in docs/frontend.md (known passwords) on an empty
# database; `pnpm dev` depends on it, the e2e stack sets its own. Production refuses to start with SEED_DEMO_DATA=true
# (and NODE_ENV accepts only development, test or production). The seeded two-factor admin gets a random TOTP secret,
# stored encrypted; its enrolment URI is printed once to the terminal (development only), and
# `pnpm --filter @betng/identity-service totp:dev` prints the current code. SEED_ADMIN_TOTP_SECRET pins it (not in production).
# There is no mail server, so a registration code is only visible in the identity log when logging is on (never in production).
SEED_DEMO_DATA=true
LOG_VERIFICATION_CODES=true

# Play-money opening balances (kobo) and the default shop share of a period's result.
WELCOME_GRANT_KOBO=10000000
SHOP_OPENING_FLOAT_KOBO=50000000
DEFAULT_SHOP_SHARE_PERCENT=20

# IANA zone used to cut report days and hours.
ANALYTICS_REPORT_TIMEZONE=UTC

# Wallet payments (apps/services/wallet/README.md). Secrets are placeholders here; set real ones only in the
# deployment's secret store. Production refuses to start with the sandbox, a test key, a missing encryption key or
# an http callback. PAYMENTS_PROVIDER: paystack | flutterwave | bachs (configuration required) | sandbox | none.
PAYMENTS_PROVIDER=sandbox
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
PAYMENTS_CALLBACK_BASE_URL=http://localhost:5173
PAYMENTS_DEFAULT_RETURN_PATH=/wallet
PAYMENTS_PROVIDER_TIMEOUT_MS=10000
PAYMENTS_DEPOSIT_MIN_KOBO=10000
PAYMENTS_DEPOSIT_MAX_KOBO=100000000
PAYMENTS_DEPOSIT_TTL_MINUTES=30
WITHDRAWAL_MIN_KOBO=100000
WITHDRAWAL_MAX_KOBO=500000000
WITHDRAWAL_FEE_KOBO=2500
WITHDRAWAL_FEE_HIGH_KOBO=5000
WITHDRAWAL_FEE_HIGH_FROM_KOBO=5000000
WITHDRAWAL_REVIEW_THRESHOLD_KOBO=50000000
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts bank account numbers at rest.
WALLET_ENCRYPTION_KEY=
# S3-compatible storage for statements (https endpoint origin). Unset: statements end FAILED with no link.
WALLET_STORAGE_ENDPOINT=
WALLET_STORAGE_REGION=
WALLET_STORAGE_BUCKET=
WALLET_STORAGE_ACCESS_KEY_ID=
WALLET_STORAGE_SECRET_ACCESS_KEY=
WALLET_STORAGE_FORCE_PATH_STYLE=true
WALLET_JOBS_ENABLED=true
WALLET_JOBS_INTERVAL_MS=30000

# --- Identity: account security, delivery, KYC (apps/services/identity/README.md) -------
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts TOTP secrets and push tokens, keys the BVN/NIN and
# backup-code hashes. Unset outside production uses a public development key; production refuses to start without one.
IDENTITY_DATA_KEY=
# Admins without two-factor authentication cannot sign in. Defaults to true in production, false elsewhere.
# ADMIN_TOTP_REQUIRED=
# HIBP k-anonymity range check on new passwords (fails open, logged).
PASSWORD_BREACH_CHECK=false
# CUSTOMER_SESSION_MAX_HOURS=720
# ACCOUNT_DELETION_COOLING_DAYS=14
# EMAIL_PROVIDER: log (development only) | sendgrid. SMS_PROVIDER / PUSH_PROVIDER: none | log (development only) | termii / fcm.
EMAIL_PROVIDER=log
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=BetNG
SMS_PROVIDER=none
TERMII_API_KEY=
TERMII_SENDER_ID=
# The base URL shown on the Termii dashboard (https).
TERMII_BASE_URL=
TERMII_CHANNEL=dnd
PUSH_PROVIDER=none
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# The service account's private key, PEM with \n escapes.
FCM_PRIVATE_KEY=
# DELIVERY_TIMEOUT_MS=8000
# S3-compatible storage for KYC documents (https endpoint). Unset: uploads answer 503, never a fake ticket.
KYC_STORAGE_ENDPOINT=
KYC_STORAGE_REGION=
KYC_STORAGE_BUCKET=
KYC_STORAGE_ACCESS_KEY_ID=
KYC_STORAGE_SECRET_ACCESS_KEY=
KYC_STORAGE_FORCE_PATH_STYLE=true
# sandbox (development/test only, deterministic) | unconfigured (answers 503 until an approved provider is integrated).
KYC_IDENTITY_PROVIDER=sandbox

# --- Gateway hardening ---------------------------------------------------------
# Unset values use the defaults shown. Rate rules are `limit/windowSeconds`; outside production the
# global rule defaults to 3000/60 because every local app shares one loopback address.
# GATEWAY_RATE_GLOBAL=300/60
# GATEWAY_RATE_CREDENTIAL=10/60
# GATEWAY_RATE_BETS=30/60
# GATEWAY_RATE_DEPOSITS=10/300
# GATEWAY_RATE_WITHDRAWALS=5/600
# GATEWAY_RATE_STATEMENTS=5/3600
# GATEWAY_RATE_KYC_UPLOADS=10/3600
# GATEWAY_RATE_VERIFICATION=5/600
# GATEWAY_RATE_EXPORTS=3/3600
# GATEWAY_RATE_WEBHOOKS=600/60
# GATEWAY_RATE_HEALTH=30/60
# Seconds an authenticated actor is cached (0-10).
# GATEWAY_ACTOR_CACHE_SECONDS=5
# GATEWAY_MAX_BODY_BYTES=65536
# GATEWAY_WEBHOOK_MAX_BODY_BYTES=32768
# Proxy hops (or proxy addresses, comma separated) in front of the gateway; `*` is refused. Unset or false
# trusts none. Behind the compose TLS edge this is 1 (set in docker-compose.yml).
# GATEWAY_TRUST_PROXY=
# on | off; defaults to on in production.
# GATEWAY_HSTS=
# on | off (default off). Browser sign-ins from a CORS_ORIGINS page get an HttpOnly `betng_session` cookie and a readable
# `betng_csrf` cookie; every non-GET cookie request must echo the latter in `x-csrf-token` or gets 403. Requests with a
# bearer (native apps, scripts) are unaffected. Pair with the apps' VITE_AUTH_TRANSPORT=cookie.
# GATEWAY_SESSION_COOKIE=off
# Parent domain shared by the apps and the API (e.g. betng.ng) so the apps can read the CSRF cookie; unset = API host only.
# GATEWAY_SESSION_COOKIE_DOMAIN=
# Comma-separated addresses or CIDR ranges refused outright.
# GATEWAY_IP_BLOCKLIST=
# GATEWAY_REDIS_PREFIX=gateway

# --- Realtime (event service) ----------------------------------------------------
# EVENT_MAX_CONNECTIONS_PER_IP=20
# EVENT_AUTH_REVALIDATE_SECONDS=30
# Proxies in front of /live that append to X-Forwarded-For (0-5). Behind the compose TLS edge this is 1.
# EVENT_TRUSTED_PROXY_HOPS=0
# EVENT_MAX_FRAMES_PER_10S=60
# EVENT_MAX_CHANNELS_PER_CONNECTION=50

# --- Shutdown (every service) ----------------------------------------------------
# Time to finish in-flight requests, then the hard stop. Keep both below the container stop grace period (30s).
# SHUTDOWN_DRAIN_MS=10000
# SHUTDOWN_TIMEOUT_MS=15000

# --- Containers (infrastructure/docker/docker-compose.yml, docs/operations.md) ----------
# Production keeps these in an env file outside the repository. Local defaults apply when unset.
# Required for production: services with NODE_ENV=production refuse a REDIS_URL without a password. URL-safe (hex).
# The platform services' REDIS_URL is built from it; PLATFORM_REDIS_URL overrides that. Local development leaves it empty.
# REDIS_PASSWORD=
# PLATFORM_REDIS_URL=
# MATCH_DB_PASSWORD= BETTING_DB_PASSWORD= WALLET_DB_PASSWORD= SETTLEMENT_DB_PASSWORD= IDENTITY_DB_PASSWORD=
# SIMULATION_DB_PASSWORD= ODDS_DB_PASSWORD= RISK_DB_PASSWORD= ANALYTICS_DB_PASSWORD=
# BETNG_ENV_DIR=/etc/betng/env
# EDGE_DOMAIN=betng.localhost
# EDGE_CERTS_DIR=/etc/betng/tls
# EDGE_BIND_ADDRESS=0.0.0.0
# EDGE_HTTP_PORT=80
# EDGE_HTTPS_PORT=443
# GRAFANA_ADMIN_PASSWORD=
# INTERNAL_SERVICE_TOKEN_FILE=/etc/betng/secrets/internal_service_token
# GRAFANA_PUBLISHED_PORT=3900
# BACKUP_HOST_DIR=/var/backups/betng
# BACKUP_PGPASSWORD=
# BACKUP_RETENTION_DAYS=14
# MONITOR_PGPASSWORD=

# Browser push (VAPID): all three or none; identity signs and sends, match publishes the public key on /config.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
