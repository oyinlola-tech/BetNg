# ---------------------------------------------------------------------------
# BetNG — development environment template
#
# Copy to `.env` and adjust. `.env` is git-ignored; never commit real secrets.
# Every value here is a local development default for a simulation-only
# portfolio project. There are no real credentials in this file.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
HOST=0.0.0.0

# --- Service ports ---------------------------------------------------------
GATEWAY_PORT=3000
MATCH_PORT=3001
BETTING_PORT=3002
WALLET_PORT=3003
SETTLEMENT_PORT=3004
SIMULATION_PORT=3005
ODDS_PORT=3006
RISK_PORT=3007

# --- Service discovery -----------------------------------------------------
# Never hard-code these in application logic; always read them from config.
GATEWAY_SERVICE_URL=http://localhost:3000
MATCH_SERVICE_URL=http://localhost:3001
BETTING_SERVICE_URL=http://localhost:3002
WALLET_SERVICE_URL=http://localhost:3003
SETTLEMENT_SERVICE_URL=http://localhost:3004
SIMULATION_SERVICE_URL=http://localhost:3005
ODDS_SERVICE_URL=http://localhost:3006
RISK_SERVICE_URL=http://localhost:3007

# How long a service waits on another service before giving up (ms).
SERVICE_TIMEOUT_MS=5000

# --- PostgreSQL ------------------------------------------------------------
# One database per owning service, each with its own login. A service can
# reach its own data and nothing else, so the ownership boundary in
# docs/architecture.md is enforced by credentials rather than by convention.
#
# These belong to a local container holding simulated data. They are not
# secrets and nothing here is reachable beyond this machine.
POSTGRES_USER=betng
POSTGRES_PASSWORD=betng_local_dev
POSTGRES_HOST=localhost
# 55432, not 5432: the compose stack avoids clashing with any PostgreSQL a
# developer already runs. Change it here and in the compose file together.
POSTGRES_PORT=55432

MATCH_DATABASE_URL=postgresql://betng_match:betng_match_local@localhost:55432/betng_match
BETTING_DATABASE_URL=postgresql://betng_betting:betng_betting_local@localhost:55432/betng_betting
WALLET_DATABASE_URL=postgresql://betng_wallet:betng_wallet_local@localhost:55432/betng_wallet
SETTLEMENT_DATABASE_URL=postgresql://betng_settlement:betng_settlement_local@localhost:55432/betng_settlement

# Prisma's `migrate dev` diffs the schema against a throwaway database.
# Pointing it at a dedicated one keeps the service roles unprivileged: none
# of them needs CREATEDB. Only `migrate dev` uses these; `migrate deploy`,
# which is what runs outside development, does not.
MATCH_SHADOW_DATABASE_URL=postgresql://betng_match:betng_match_local@localhost:55432/betng_match_shadow
BETTING_SHADOW_DATABASE_URL=postgresql://betng_betting:betng_betting_local@localhost:55432/betng_betting_shadow
WALLET_SHADOW_DATABASE_URL=postgresql://betng_wallet:betng_wallet_local@localhost:55432/betng_wallet_shadow
SETTLEMENT_SHADOW_DATABASE_URL=postgresql://betng_settlement:betng_settlement_local@localhost:55432/betng_settlement_shadow

# --- Redis -----------------------------------------------------------------
# Reserved for caching, short-lived match state and coordination.
REDIS_URL=redis://localhost:56379
