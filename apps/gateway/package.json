{
  "name": "@betng/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BetNG gateway — the platform's external API entry point: routing, request validation, API versioning and service access.",
  "zudojs": {
    "features": []
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@betng/contracts": "workspace:*",
    "@betng/service-kit": "workspace:*",
    "@zudojs/container": "1.1.2",
    "@zudojs/errors": "1.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
