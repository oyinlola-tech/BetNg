# BetNG web client — development environment template.
#
# Vite only exposes variables prefixed VITE_ to the bundle, which is what
# keeps a server-side secret from being shipped to a browser by accident.

# The gateway. Every REST call goes through it.
VITE_GATEWAY_URL=http://localhost:3000

# The event service's live stream, connected to directly.
VITE_LIVE_URL=ws://localhost:3008/live
