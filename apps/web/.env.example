# Where the clients read from: "mock" runs a virtual season in the browser,
# "platform" talks to the gateway and event service below.
VITE_DATA_SOURCE=mock
VITE_GATEWAY_URL=http://localhost:3000
VITE_LIVE_URL=ws://localhost:3008/live
# The demo user the simulated wallet and bets belong to (platform mode).
VITE_USER_ID=11111111-1111-4111-8111-111111111111
