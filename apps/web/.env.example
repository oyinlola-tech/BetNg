# Public, build-time configuration. Never put a secret here: everything in a
# VITE_ variable ships to the browser. See docs/api-integration.md.

# development | test | staging | production
VITE_APP_ENV=development

# The public gateway and the public realtime endpoint. No other service URL belongs in a client.
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3008/live

# websocket | sse
VITE_REALTIME_TRANSPORT=websocket
# none | frame | query
VITE_REALTIME_AUTH=none

# Optional build-time overrides, e.g. walletEnabled=false,tvEnabled=true
VITE_FEATURE_FLAGS=

VITE_REQUEST_TIMEOUT_MS=10000
VITE_LOG_LEVEL=info

# Public origin of the web app, for canonical and Open Graph URLs.
VITE_SITE_URL=http://localhost:4200

# bearer | cookie. `cookie` when the gateway issues an HttpOnly session cookie (sends credentials and the CSRF header).
VITE_AUTH_TRANSPORT=bearer

# Optional per-feature switches (true | false). Unset means the built-in default.
VITE_FEATURE_PAYMENTS=
VITE_FEATURE_KYC=
VITE_FEATURE_RESPONSIBLE_GAMING=
VITE_FEATURE_TWO_FACTOR=
VITE_FEATURE_ACCOUNT_SESSIONS=
VITE_FEATURE_STATEMENTS=
VITE_FEATURE_NOTIFICATIONS=
VITE_FEATURE_ACCOUNT_DELETION=
VITE_FEATURE_CASH_SHIFTS=
VITE_FEATURE_COMPLIANCE=

# Comma-separated hosts (a leading dot allows subdomains). Uploads and hosted-checkout redirects
# to any other host are refused. Mirror them in the container's BETNG_UPLOAD_ORIGINS / BETNG_CHECKOUT_ORIGINS.
VITE_UPLOAD_HOSTS=
VITE_CHECKOUT_HOSTS=

# Cookieless, Plausible-compatible usage counts. Both unset (the default) means nothing is sent.
# The collector origin must also be added to the CSP connect-src of the web container.
VITE_ANALYTICS_DOMAIN=
VITE_ANALYTICS_HOST=
