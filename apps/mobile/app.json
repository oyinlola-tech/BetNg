{
  "expo": {
    "name": "BetNG",
    "slug": "betng",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "betng",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A0C10",
    "splash": {
      "backgroundColor": "#0A0C10",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.betng.app"
    },
    "android": {
      "package": "ng.betng.app",
      "softwareKeyboardLayoutMode": "pan"
    },
    "extra": {
      "appEnv": "development",
      "apiUrl": "http://localhost:3000",
      "realtimeUrl": "ws://localhost:3008/live",
      "realtimeTransport": "websocket",
      "realtimeAuth": "none"
    }
  }
}
