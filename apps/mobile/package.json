{
  "name": "@betng/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "BetNG mobile client — a dedicated virtual football app: lobby, live matches, markets, bet slip, wallet, match TV and history.",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf .expo *.tsbuildinfo"
  },
  "dependencies": {
    "@betng/client-sdk": "workspace:*",
    "@betng/contracts": "workspace:*",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.4"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "7.0.2"
  }
}
