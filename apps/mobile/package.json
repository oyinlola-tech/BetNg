{
  "name": "@betng/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "description": "BetNG mobile client \u2014 a dedicated virtual football app: lobby, live matches, markets, bet slip, wallet, match TV and history.",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
