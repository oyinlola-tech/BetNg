// The `settlement` schema. Other services' ids are plain columns, not foreign keys. Status columns are text
// with CHECK constraints, and the append-only rules are triggers: both live in the second migration.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Written once; only `effects_applied_at` is ever set, once, when the effects have been applied.
model Settlement {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  betId            String    @map("bet_id") @db.Uuid
  /// `(bet_id, revision)` is the no-double-pay key.
  revision         Int       @default(1)
  outcome          String
  stake            BigInt
  payout           BigInt
  channel          String
  userId           String?   @map("user_id") @db.Uuid
  shopId           String?   @map("shop_id") @db.Uuid
  cashierId        String?   @map("cashier_id") @db.Uuid
  periodId         String    @map("period_id")
  effectsAppliedAt DateTime? @map("effects_applied_at") @db.Timestamptz(3)
  settledAt        DateTime  @default(now()) @map("settled_at") @db.Timestamptz(3)

  period      OperatorPeriod       @relation(fields: [periodId], references: [id])
  selections  SettledSelection[]
  ledgerEntry OperatorLedgerEntry?

  @@unique([betId, revision])
  @@index([userId, settledAt])
  @@index([periodId])
  @@index([settledAt])
  @@map("settlements")
}

/// `selection_id` is `betting.bet_selections.selection_id`.
model SettledSelection {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlementId String  @map("settlement_id") @db.Uuid
  selectionId  String  @map("selection_id") @db.Uuid
  matchId      String  @map("match_id") @db.Uuid
  outcome      String
  result       String?

  settlement Settlement @relation(fields: [settlementId], references: [id])

  @@unique([settlementId, selectionId])
  @@index([matchId])
  @@map("settled_selections")
}

model MatchSettlement {
  matchId       String    @id @map("match_id") @db.Uuid
  /// `RESULT` or `VOID`.
  kind          String    @default("RESULT")
  status        String
  betsTotal     Int       @default(0) @map("bets_total")
  betsSettled   Int       @default(0) @map("bets_settled")
  attempts      Int       @default(0)
  failureReason String?   @map("failure_reason")
  startedAt     DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt   DateTime? @map("completed_at") @db.Timestamptz(3)

  @@index([status])
  @@map("match_settlements")
}

/// `SESSION-YYYYMMDD-NNNN`. At most one is OPEN (partial unique index).
model OperatorPeriod {
  id       String    @id
  kind     String
  status   String
  startsAt DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt   DateTime? @map("ends_at") @db.Timestamptz(3)

  settlements Settlement[]
  entries     OperatorLedgerEntry[]
  ledger      OperatorLedger?
  commissions CommissionLedger[]

  @@index([status])
  @@map("operator_periods")
}

model OperatorLedgerEntry {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlementId String   @unique @map("settlement_id") @db.Uuid
  periodId     String   @map("period_id")
  betId        String   @map("bet_id") @db.Uuid
  channel      String
  userId       String?  @map("user_id") @db.Uuid
  shopId       String?  @map("shop_id") @db.Uuid
  cashierId    String?  @map("cashier_id") @db.Uuid
  outcome      String
  stake        BigInt
  payout       BigInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  settlement Settlement     @relation(fields: [settlementId], references: [id])
  period     OperatorPeriod @relation(fields: [periodId], references: [id])

  @@index([periodId, shopId])
  @@map("operator_ledger_entries")
}

/// `operator_result` may be negative and is recorded as it is.
model OperatorLedger {
  periodId           String   @id @map("period_id")
  grossStakes        BigInt   @map("gross_stakes")
  grossPayouts       BigInt   @map("gross_payouts")
  operatorResult     BigInt   @map("operator_result")
  operatorResultRate Decimal  @map("operator_result_rate") @db.Decimal(9, 6)
  settledBets        Int      @map("settled_bets")
  voidBets           Int      @map("void_bets")
  refundedStakes     BigInt   @map("refunded_stakes")
  status             String
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  period OperatorPeriod @relation(fields: [periodId], references: [id])

  @@map("operator_ledger")
}

/// Versioned by `effective_from`; a change is a new row. `shop_id` null is the platform default.
model CommissionConfig {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  shopId           String?  @map("shop_id") @db.Uuid
  shopSharePercent Decimal  @map("shop_share_percent") @db.Decimal(5, 2)
  effectiveFrom    DateTime @default(now()) @map("effective_from") @db.Timestamptz(3)
  createdBy        String   @map("created_by")
  reason           String

  @@index([shopId, effectiveFrom])
  @@map("commission_config")
}

model CommissionLedger {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  periodId             String   @map("period_id")
  shopId               String   @map("shop_id") @db.Uuid
  grossStakes          BigInt   @map("gross_stakes")
  grossPayouts         BigInt   @map("gross_payouts")
  grossOperatorResult  BigInt   @map("gross_operator_result")
  shopSharePercent     Decimal  @map("shop_share_percent") @db.Decimal(5, 2)
  shopShareAmount      BigInt   @map("shop_share_amount")
  platformSharePercent Decimal  @map("platform_share_percent") @db.Decimal(5, 2)
  platformShareAmount  BigInt   @map("platform_share_amount")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  period OperatorPeriod @relation(fields: [periodId], references: [id])

  @@unique([periodId, shopId])
  @@map("commission_ledger")
}
