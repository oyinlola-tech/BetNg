// BetNG match service schema (`match` schema of the `betng` database).
//
// This service owns the catalogue (leagues, teams), fixtures, matches and the
// lifecycle transition log. Match events and results belong to the simulation
// service (`simulation.match_events`, `simulation.match_results`) and are read
// cross-schema, never copied here: a match row carries only the *revealed*
// running score.
//
// The column names below are part of the shared read model in
// `docs/architecture.md` §8: other services read them, so they may be added to
// but not renamed or retyped.
//
// Prisma 7 no longer takes the connection URL here: migrations read it from
// `prisma.config.ts`, and the client is built with a driver adapter.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum LeagueStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED

  @@map("league_status")
}

/// A competition the platform runs. The scheduler creates rounds only for ACTIVE leagues.
model League {
  id             String       @id @default(uuid()) @db.Uuid
  name           String       @db.VarChar(120)
  code           String       @unique @db.VarChar(8)
  slug           String       @unique @db.VarChar(40)
  country        String       @db.VarChar(60)
  sport          String       @default("football") @db.VarChar(32)
  status         LeagueStatus @default(ACTIVE)
  /// Offset of this league's kick-offs within the round cycle, so leagues do not all start together.
  staggerSeconds Int          @default(0) @map("stagger_seconds")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  teams    Team[]
  fixtures Fixture[]

  @@map("leagues")
}

enum TeamStatus {
  ACTIVE
  INACTIVE

  @@map("team_status")
}

/// A team and its simulation inputs. Ratings are properties of the team, never of a bettor.
model Team {
  id             String     @id @default(uuid()) @db.Uuid
  leagueId       String     @map("league_id") @db.Uuid
  name           String     @db.VarChar(120)
  shortName      String     @map("short_name") @db.VarChar(12)
  code           String     @db.VarChar(4)
  city           String     @default("") @db.VarChar(60)
  stadium        String     @default("") @db.VarChar(80)
  colorPrimary   String     @default("#1F2937") @map("color_primary") @db.VarChar(7)
  colorSecondary String     @default("#FFFFFF") @map("color_secondary") @db.VarChar(7)
  status         TeamStatus @default(ACTIVE)
  strength       Int
  attack         Int
  defence        Int
  midfield       Int
  goalkeeping    Int
  pace           Int
  finishing      Int
  possession     Int
  form           Int        @default(0)
  homeAdvantage  Int        @default(55) @map("home_advantage")
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  league       League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  homeFixtures Fixture[] @relation("HomeTeam")
  awayFixtures Fixture[] @relation("AwayTeam")

  @@unique([leagueId, code])
  @@index([leagueId])
  @@map("teams")
}

/// A scheduled pairing. The Match is the instance of it that gets played.
model Fixture {
  id              String   @id @default(uuid()) @db.Uuid
  leagueId        String   @map("league_id") @db.Uuid
  season          Int      @default(1)
  matchday        Int
  homeTeamId      String   @map("home_team_id") @db.Uuid
  awayTeamId      String   @map("away_team_id") @db.Uuid
  kickoffAt       DateTime @map("kickoff_at") @db.Timestamptz(3)
  bettingClosesAt DateTime @map("betting_closes_at") @db.Timestamptz(3)
  /// SCHEDULER for a round of the rotation, ADMIN for a fixture added by hand. Only the former advances the rotation.
  source          String   @default("SCHEDULER") @db.VarChar(16)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  homeTeam Team   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeam Team   @relation("AwayTeam", fields: [awayTeamId], references: [id])
  match    Match?

  @@unique([leagueId, season, matchday, homeTeamId, awayTeamId])
  @@index([leagueId, season, matchday])
  @@index([kickoffAt])
  @@index([bettingClosesAt])
  @@map("fixtures")
}

/// The public projection of `Match.lifecycle`. See docs/architecture.md §5.
enum MatchStatus {
  SCHEDULED
  BETTING_OPEN
  BETTING_CLOSED
  IN_PLAY
  COMPLETED
  CANCELLED

  @@map("match_status")
}

/// One virtual match.
model Match {
  id                  String      @id @default(uuid()) @db.Uuid
  fixtureId           String      @unique @map("fixture_id") @db.Uuid
  status              MatchStatus @default(SCHEDULED)
  /// Canonical state; a CHECK constraint restricts it to the §5 values.
  lifecycle           String      @default("FIXTURE_CREATED") @db.VarChar(32)
  /// The revealed running score: null before kick-off, final only once COMPLETED.
  homeScore           Int?        @map("home_score")
  awayScore           Int?        @map("away_score")
  /// Highest `simulation.match_events.sequence` already revealed.
  revealedSequence    Int         @default(0) @map("revealed_sequence")
  /// The ratings the markets were priced from; the simulation runs on the same ones.
  homeStrength        Json?       @map("home_strength")
  awayStrength        Json?       @map("away_strength")
  bettingOpenedAt     DateTime?   @map("betting_opened_at") @db.Timestamptz(3)
  bettingClosedAt     DateTime?   @map("betting_closed_at") @db.Timestamptz(3)
  simulationStartedAt DateTime?   @map("simulation_started_at") @db.Timestamptz(3)
  completedAt         DateTime?   @map("completed_at") @db.Timestamptz(3)
  settledAt           DateTime?   @map("settled_at") @db.Timestamptz(3)
  voidedAt            DateTime?   @map("voided_at") @db.Timestamptz(3)
  failureReason       String?     @map("failure_reason") @db.VarChar(240)
  failureCount        Int         @default(0) @map("failure_count")
  /// Earliest instant the scheduler may try this match's pending step again. Doubles as the
  /// lease a worker holds while a peer call is in flight.
  nextAttemptAt       DateTime?   @map("next_attempt_at") @db.Timestamptz(3)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  fixture     Fixture           @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  transitions MatchTransition[]

  @@index([lifecycle])
  @@index([status])
  @@map("matches")
}

/// Append-only log of lifecycle transitions, written in the same transaction as the state change.
model MatchTransition {
  id        String   @id @default(uuid()) @db.Uuid
  /// Insertion order; `at` alone cannot order two transitions committed in the same millisecond.
  sequence  BigInt   @unique @default(autoincrement())
  matchId   String   @map("match_id") @db.Uuid
  fromState String?  @map("from_state") @db.VarChar(32)
  toState   String   @map("to_state") @db.VarChar(32)
  at        DateTime @default(now()) @db.Timestamptz(3)
  actor     String   @db.VarChar(80)
  reason    String?  @db.VarChar(240)

  match Match @relation(fields: [matchId], references: [id], onDelete: Restrict)

  @@index([matchId, sequence])
  @@map("match_transitions")
}
