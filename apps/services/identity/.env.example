# Identity service. Placeholders only; the repository-root .env.example holds the shared values.
IDENTITY_PORT=3010
IDENTITY_DATABASE_URL=postgresql://betng_identity:betng_identity_local@localhost:55432/betng?schema=identity
REDIS_URL=redis://localhost:56379
EVENT_SERVICE_URL=http://localhost:3008

# 32 random bytes, base64 (openssl rand -base64 32). Required in production.
IDENTITY_DATA_KEY=

CUSTOMER_SESSION_TTL_HOURS=168
CUSTOMER_SESSION_MAX_HOURS=720
CASHIER_SESSION_TTL_HOURS=12
ADMIN_SESSION_TTL_HOURS=8
# Defaults to true in production.
ADMIN_TOTP_REQUIRED=
PASSWORD_BREACH_CHECK=false
ACCOUNT_DELETION_COOLING_DAYS=14

# log (development only) | sendgrid
EMAIL_PROVIDER=log
SENDGRID_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=BetNG
# none | log (development only) | termii
SMS_PROVIDER=none
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=
TERMII_CHANNEL=dnd
# none | log (development only) | fcm
PUSH_PROVIDER=none
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Browser push (VAPID): all three or none. Base64url raw P-256 keys: 65-byte public, 32-byte private. The match service publishes the public key on /config.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for push services.
VAPID_SUBJECT=
DELIVERY_TIMEOUT_MS=8000

# S3-compatible, https. All five or none.
KYC_STORAGE_ENDPOINT=
KYC_STORAGE_REGION=
KYC_STORAGE_BUCKET=
KYC_STORAGE_ACCESS_KEY_ID=
KYC_STORAGE_SECRET_ACCESS_KEY=
KYC_STORAGE_FORCE_PATH_STYLE=true
# sandbox (development/test only) | unconfigured
KYC_IDENTITY_PROVIDER=sandbox

# Development only; ignored in production.
SEED_DEMO_DATA=true
LOG_VERIFICATION_CODES=true
