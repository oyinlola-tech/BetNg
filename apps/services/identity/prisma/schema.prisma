// The `identity` schema. Customers, cashiers and admin users are separate tables on purpose: an admin is
// structurally not a customer (invariant 9). Secrets are stored only as hashes. Columns listed in
// docs/architecture.md §8 are read by other services and must not be renamed or retyped.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  SUSPENDED

  @@map("account_status")
}

enum ShopStatus {
  ACTIVE
  SUSPENDED
  OFFLINE

  @@map("shop_status")
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS
  RISK_ANALYST
  SUPPORT

  @@map("admin_role")
}

enum ShopRole {
  OWNER
  MANAGER
  CASHIER

  @@map("shop_role")
}

enum SessionKind {
  CUSTOMER
  CASHIER
  ADMIN

  @@map("session_kind")
}

enum AuditSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL

  @@map("audit_severity")
}

model Customer {
  id              String        @id @default(uuid()) @db.Uuid
  email           String        @unique @db.VarChar(254)
  displayName     String        @map("display_name") @db.VarChar(60)
  phone           String?       @db.VarChar(20)
  status          AccountStatus @default(ACTIVE)
  passwordHash    String        @map("password_hash")
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  lastActiveAt    DateTime      @default(now()) @map("last_active_at") @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(3)
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(3)

  verifications       EmailVerification[]
  passwordResets      PasswordReset[]
  notifications       Notification[]
  twoFactor           CustomerTwoFactor?
  twoFactorEnrollment TwoFactorEnrollment[]
  backupCodes         BackupCode[]
  loginChallenges     LoginChallenge[]
  passwordHistory     PasswordHistory[]
  deletions           AccountDeletion[]
  preferences         NotificationPreference?
  pushDevices         PushDevice[]
  kycUploads          KycUpload[]
  kycDocuments        KycDocument[]
  identityChecks      KycIdentityCheck[]
  kycProfile          KycProfile?
  limits              ResponsibleGamingLimit[]
  limitHistory        LimitHistory[]
  selfExclusions      SelfExclusion[]
  limitRefusals       LimitCheckRefusal[]

  @@index([createdAt])
  @@map("customers")
}

model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("email_verifications")
}

/// `tokenHash` is the hash of the six-digit code bound to the row id; `attempts` caps guesses per code.
model PasswordReset {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("password_resets")
}

/// `totpLastStep` is the time step of the last accepted code, so a code cannot be replayed within its window.
model AdminUser {
  id               String        @id @default(uuid()) @db.Uuid
  email            String        @unique @db.VarChar(254)
  name             String        @db.VarChar(60)
  role             AdminRole
  status           AccountStatus @default(ACTIVE)
  passwordHash     String        @map("password_hash")
  totpSecret       String?       @map("totp_secret")
  twoFactorEnabled Boolean       @default(false) @map("two_factor_enabled")
  totpLastStep     BigInt?       @map("totp_last_step")
  lastLoginAt      DateTime?     @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// Set on a one-time password. Sign-in is refused until it is exchanged for a chosen one.
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  /// When the one-time password stops working; cleared once the account is activated.
  credentialsExpireAt DateTime? @map("credentials_expire_at") @db.Timestamptz(3)
  /// True for the account the migration bootstrap created. At most one row may carry it.
  isBootstrap         Boolean   @default(false) @map("is_bootstrap")

  @@map("admin_users")
}

model Shop {
  id        String     @id @default(uuid()) @db.Uuid
  code      String     @unique @db.VarChar(20)
  name      String     @db.VarChar(80)
  address   String     @db.VarChar(160)
  phone     String     @db.VarChar(20)
  email     String     @db.VarChar(254)
  status    ShopStatus @default(ACTIVE)
  ownerName String     @map("owner_name") @db.VarChar(80)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  cashiers Cashier[]

  @@map("shops")
}

/// `credentialsExpireAt` is set when an admin issues credentials and cleared by the first sign-in; unused past it, they stop working.
model Cashier {
  id                  String        @id @default(uuid()) @db.Uuid
  shopId              String        @map("shop_id") @db.Uuid
  username            String        @db.VarChar(40)
  displayName         String        @map("display_name") @db.VarChar(60)
  role                ShopRole
  status              AccountStatus @default(ACTIVE)
  passwordHash        String        @map("password_hash")
  pinHash             String        @map("pin_hash")
  credentialsExpireAt DateTime?     @map("credentials_expire_at") @db.Timestamptz(3)
  lastActiveAt        DateTime?     @map("last_active_at") @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Restrict)

  @@unique([shopId, username])
  @@map("cashiers")
}

/// Only the SHA-256 of a session token is stored. For a revoked session, `cacheEvictedAt` records that the gateway's cached actor
/// was deleted and `realtimeRevokedAt` that the event service dropped its private subscriptions.
model Session {
  id             String      @id @default(uuid()) @db.Uuid
  kind           SessionKind
  subjectId      String      @map("subject_id") @db.Uuid
  tokenHash      String      @unique @map("token_hash")
  expiresAt      DateTime    @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime?   @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime    @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  device         String?     @db.VarChar(80)
  browser        String?     @db.VarChar(80)
  platform       String?     @db.VarChar(80)
  cacheEvictedAt    DateTime? @map("cache_evicted_at") @db.Timestamptz(3)
  realtimeRevokedAt DateTime? @map("realtime_revoked_at") @db.Timestamptz(3)

  @@index([kind, subjectId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Keyed by a hash of the typed identifier, not by account, so the lockout cannot enumerate accounts.
model LoginThrottle {
  keyHash     String    @id @map("key_hash")
  failures    Int       @default(0)
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([updatedAt])
  @@map("login_throttles")
}

/// `dedupeKey` makes `identity.notify` idempotent for a caller that retries.
model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  kind       String
  title      String
  body       String
  data       Json?
  dedupeKey  String?   @map("dedupe_key") @db.VarChar(120)
  readAt     DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, dedupeKey])
  @@index([customerId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Append-only: the `audit_append_only` migration rejects UPDATE, DELETE and TRUNCATE.
model AuditLog {
  id         String        @id @default(uuid()) @db.Uuid
  actorId    String        @map("actor_id") @db.VarChar(80)
  actorRole  String        @map("actor_role") @db.VarChar(40)
  actorName  String        @map("actor_name") @db.VarChar(80)
  action     String        @db.VarChar(80)
  entityType String        @map("entity_type") @db.VarChar(80)
  entityId   String        @map("entity_id") @db.VarChar(80)
  before     Json?
  after      Json?
  reason     String?       @db.VarChar(240)
  severity   AuditSeverity @default(INFO)
  requestId  String        @map("request_id") @db.VarChar(64)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([severity, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model PlatformSettings {
  id        Int      @id @default(1) @db.SmallInt
  value     Json
  version   Int      @default(1)
  updatedBy String   @map("updated_by") @db.VarChar(80)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("platform_settings")
}

enum ShopApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  REQUIRES_ACTION

  @@map("shop_application_status")
}

enum ShopApplicationDocumentType {
  CAC_CERTIFICATE
  OWNER_ID
  PROOF_OF_ADDRESS
  PREMISES_PHOTO

  @@map("shop_application_document_type")
}

/// A public submission from someone who wants to run a shop. `reference` is high-entropy and is the only
/// handle the applicant has; a status lookup needs it *and* the verified address, so the table cannot be
/// enumerated. Approval turns one of these into a `Shop` and its `OWNER` cashier, in one transaction.
model ShopApplication {
  id               String                @id @default(uuid()) @db.Uuid
  reference        String                @unique @db.VarChar(40)
  status           ShopApplicationStatus @default(PENDING)
  applicantName    String                @map("applicant_name") @db.VarChar(80)
  applicantEmail   String                @map("applicant_email") @db.VarChar(254)
  applicantPhone   String                @map("applicant_phone") @db.VarChar(20)
  businessName     String                @map("business_name") @db.VarChar(80)
  rcNumber         String?               @map("rc_number") @db.VarChar(20)
  address          String                @db.VarChar(160)
  city             String                @db.VarChar(60)
  state            String                @db.VarChar(20)
  proposedShopName String                @map("proposed_shop_name") @db.VarChar(80)
  note             String?               @db.VarChar(500)
  emailVerifiedAt  DateTime?             @map("email_verified_at") @db.Timestamptz(3)
  decidedAt        DateTime?             @map("decided_at") @db.Timestamptz(3)
  decidedBy        String?               @map("decided_by") @db.VarChar(80)
  reason           String?               @db.VarChar(300)
  /// Set on approval; the shop lives in this schema, so this is a real reference.
  shopId           String?               @unique @map("shop_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  documents     ShopApplicationDocument[]
  verifications ShopApplicationVerification[]

  @@index([status, createdAt(sort: Desc)])
  @@index([applicantEmail])
  @@map("shop_applications")
}

model ShopApplicationDocument {
  id            String                      @id @default(uuid()) @db.Uuid
  applicationId String                      @map("application_id") @db.Uuid
  type          ShopApplicationDocumentType
  fileName      String                      @map("file_name") @db.VarChar(200)
  contentType   String                      @map("content_type") @db.VarChar(40)
  sizeBytes     Int                         @map("size_bytes")
  objectKey     String                      @unique @map("object_key") @db.VarChar(200)
  uploadedAt    DateTime                    @default(now()) @map("uploaded_at") @db.Timestamptz(3)

  application ShopApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, uploadedAt])
  @@map("shop_application_documents")
}

/// The applicant is not a customer, so their address is proven here rather than by `EmailVerification`.
/// Same shape: the code is stored hashed and `attempts` caps guesses.
model ShopApplicationVerification {
  id            String    @id @default(uuid()) @db.Uuid
  applicationId String    @map("application_id") @db.Uuid
  codeHash      String    @map("code_hash")
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  application ShopApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
  @@map("shop_application_verifications")
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  REQUIRES_ACTION

  @@map("kyc_status")
}

enum KycDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVERS_LICENSE
  VOTERS_CARD
  PROOF_OF_ADDRESS
  SELFIE

  @@map("kyc_document_type")
}

enum IdentityCheckKind {
  BVN
  NIN

  @@map("identity_check_kind")
}

enum AccountDeletionStatus {
  PENDING
  CANCELLED
  COMPLETED

  @@map("account_deletion_status")
}

enum PushPlatform {
  web
  ios
  android

  @@map("push_platform")
}

/// The TOTP secret is AES-256-GCM ciphertext bound to the customer id; `lastStep` is the last accepted time step (replay guard).
model CustomerTwoFactor {
  customerId       String   @id @map("customer_id") @db.Uuid
  secretCiphertext String   @map("secret_ciphertext")
  lastStep         BigInt?  @map("last_step")
  enabledAt        DateTime @map("enabled_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_two_factor")
}

model TwoFactorEnrollment {
  id               String    @id @default(uuid()) @db.Uuid
  customerId       String    @map("customer_id") @db.Uuid
  secretCiphertext String    @map("secret_ciphertext")
  attempts         Int       @default(0)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt       DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("two_factor_enrollments")
}

/// Keyed hash only; a code is spent by setting `usedAt` in a conditional update.
model BackupCode {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  codeHash   String    @unique @map("code_hash")
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("backup_codes")
}

/// A password-proven sign-in waiting for its second factor. Only the hash of the challenge id handed to the client is stored.
model LoginChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  customerId String    @map("customer_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  device     String?   @db.VarChar(80)
  browser    String?   @db.VarChar(80)
  platform   String?   @db.VarChar(80)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([expiresAt])
  @@map("login_challenges")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt(sort: Desc)])
  @@map("password_history")
}

/// At most one PENDING request per customer (partial unique index in the migration).
model AccountDeletion {
  id             String                @id @default(uuid()) @db.Uuid
  customerId     String                @map("customer_id") @db.Uuid
  status         AccountDeletionStatus @default(PENDING)
  reason         String?               @db.VarChar(500)
  idempotencyKey String                @map("idempotency_key") @db.VarChar(120)
  requestedAt    DateTime              @default(now()) @map("requested_at") @db.Timestamptz(3)
  scheduledFor   DateTime              @map("scheduled_for") @db.Timestamptz(3)
  cancelledAt    DateTime?             @map("cancelled_at") @db.Timestamptz(3)
  completedAt    DateTime?             @map("completed_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, idempotencyKey])
  @@index([status, scheduledFor])
  @@map("account_deletions")
}

model NotificationPreference {
  customerId String   @id @map("customer_id") @db.Uuid
  channels   Json
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// The token is kept as a keyed hash (lookup) and AES-256-GCM ciphertext (sending); it is never returned.
model PushDevice {
  id              String       @id @db.Uuid
  customerId      String       @map("customer_id") @db.Uuid
  platform        PushPlatform
  label           String       @db.VarChar(80)
  tokenHash       String       @unique @map("token_hash")
  tokenCiphertext String       @map("token_ciphertext")
  sessionId       String?      @map("session_id") @db.Uuid
  registeredAt    DateTime     @default(now()) @map("registered_at") @db.Timestamptz(3)
  lastSeenAt      DateTime?    @map("last_seen_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, registeredAt])
  @@map("push_devices")
}

/// A single-use upload ticket. The object key is derived from the ids, never from the client's file name.
model KycUpload {
  id          String          @id @db.Uuid
  customerId  String          @map("customer_id") @db.Uuid
  type        KycDocumentType
  fileName    String          @map("file_name") @db.VarChar(200)
  contentType String          @map("content_type") @db.VarChar(40)
  sizeBytes   Int             @map("size_bytes")
  objectKey   String          @map("object_key") @db.VarChar(200)
  expiresAt   DateTime        @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?       @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@map("kyc_uploads")
}

model KycDocument {
  id              String          @id @default(uuid()) @db.Uuid
  customerId      String          @map("customer_id") @db.Uuid
  type            KycDocumentType
  status          KycStatus       @default(PENDING)
  fileName        String          @map("file_name") @db.VarChar(200)
  contentType     String          @map("content_type") @db.VarChar(40)
  sizeBytes       Int             @map("size_bytes")
  objectKey       String          @unique @map("object_key") @db.VarChar(200)
  uploadedAt      DateTime        @default(now()) @map("uploaded_at") @db.Timestamptz(3)
  reviewedAt      DateTime?       @map("reviewed_at") @db.Timestamptz(3)
  reviewedBy      String?         @map("reviewed_by") @db.VarChar(80)
  rejectionReason String?         @map("rejection_reason") @db.VarChar(300)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, uploadedAt])
  @@index([status, uploadedAt])
  @@map("kyc_documents")
}

/// BVN/NIN are never stored: only a keyed hash (duplicate detection) and the last four digits.
model KycIdentityCheck {
  id                String            @id @default(uuid()) @db.Uuid
  customerId        String            @map("customer_id") @db.Uuid
  check             IdentityCheckKind
  status            KycStatus
  numberHash        String            @map("number_hash")
  numberLast4       String            @map("number_last4") @db.VarChar(4)
  provider          String            @db.VarChar(40)
  providerReference String?           @map("provider_reference") @db.VarChar(120)
  message           String?           @db.VarChar(200)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, check, createdAt(sort: Desc)])
  @@map("kyc_identity_checks")
}

/// The latest operator decision on a customer's verification.
model KycProfile {
  customerId      String    @id @map("customer_id") @db.Uuid
  decision        KycStatus
  reason          String?   @db.VarChar(300)
  reviewedAt      DateTime  @map("reviewed_at") @db.Timestamptz(3)
  reviewedBy      String    @map("reviewed_by") @db.VarChar(80)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("kyc_profiles")
}

/// Money limits in kobo, `session_minutes` in minutes. A loosening waits in `pendingValue`, a removal in `removalEffectiveAt`.
model ResponsibleGamingLimit {
  customerId         String    @map("customer_id") @db.Uuid
  kind               String    @db.VarChar(20)
  value              BigInt
  effectiveAt        DateTime  @map("effective_at") @db.Timestamptz(3)
  pendingValue       BigInt?   @map("pending_value")
  pendingEffectiveAt DateTime? @map("pending_effective_at") @db.Timestamptz(3)
  removalEffectiveAt DateTime? @map("removal_effective_at") @db.Timestamptz(3)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@id([customerId, kind])
  @@map("rg_limits")
}

/// Append-only (trigger in the migration).
model LimitHistory {
  id            String   @id @default(uuid()) @db.Uuid
  customerId    String   @map("customer_id") @db.Uuid
  kind          String   @db.VarChar(20)
  action        String   @db.VarChar(10)
  previousValue BigInt?  @map("previous_value")
  value         BigInt?
  at            DateTime @default(now()) @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, at(sort: Desc)])
  @@map("rg_limit_history")
}

model SelfExclusion {
  id          String    @id @default(uuid()) @db.Uuid
  customerId  String    @map("customer_id") @db.Uuid
  period      String    @db.VarChar(10)
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endsAt      DateTime? @map("ends_at") @db.Timestamptz(3)
  canCancelAt DateTime? @map("can_cancel_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([customerId, startedAt(sort: Desc)])
  @@map("rg_self_exclusions")
}

/// Every refusal `limits.check` answered, for the operator's responsible-gaming view.
model LimitCheckRefusal {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  action     String   @db.VarChar(12)
  code       String   @db.VarChar(24)
  amount     BigInt
  at         DateTime @default(now()) @db.Timestamptz(3)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, at(sort: Desc)])
  @@index([at])
  @@map("rg_limit_refusals")
}
