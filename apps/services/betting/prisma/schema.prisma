// The `betting` schema. Column names and types are the cross-service contract in docs/architecture.md §8.
// Ids owned by other services are plain columns: their tables belong to another login.
// Constraints and triggers Prisma cannot express are in the `bet_integrity` migration.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BetStatus {
  PENDING
  WON
  LOST
  VOID
  CANCELLED

  @@map("bet_status")
}

enum BetChannel {
  ONLINE
  SHOP

  @@map("bet_channel")
}

enum SelectionOutcome {
  PENDING
  WON
  LOST
  VOID

  @@map("selection_outcome")
}

enum TicketStatus {
  OPEN
  WON
  LOST
  VOID
  CANCELLED
  PAID
  EXPIRED

  @@map("ticket_status")
}

model Bet {
  id      String     @id @db.Uuid
  userId  String?    @map("user_id") @db.Uuid
  channel BetChannel
  shopId    String?  @map("shop_id") @db.Uuid
  cashierId String?  @map("cashier_id") @db.Uuid

  stake    BigInt
  currency String  @default("NGN") @db.Char(3)

  /// Display only: the payout is computed from the legs' integer hundredths.
  totalOdds       Decimal @map("total_odds") @db.Decimal(12, 2)
  potentialPayout BigInt  @map("potential_payout")

  status BetStatus @default(PENDING)
  payout BigInt?

  riskDecisionId String? @map("risk_decision_id") @db.Uuid
  /// Stored scoped to the actor, so one caller's key cannot collide with another's.
  idempotencyKey String  @unique @map("idempotency_key") @db.VarChar(200)

  placedAt    DateTime  @map("placed_at") @db.Timestamptz(3)
  settledAt   DateTime? @map("settled_at") @db.Timestamptz(3)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)

  selections BetSelection[]
  ticket     Ticket?

  @@index([userId, placedAt(sort: Desc)])
  @@index([status, placedAt])
  @@index([shopId, placedAt(sort: Desc)])
  @@map("bets")
}

model BetSelection {
  id          String @id @default(uuid()) @db.Uuid
  betId       String @map("bet_id") @db.Uuid
  matchId     String @map("match_id") @db.Uuid
  marketId    String @map("market_id") @db.Uuid
  selectionId String @map("selection_id") @db.Uuid
  leagueId    String @map("league_id") @db.Uuid

  marketType    String   @map("market_type") @db.VarChar(32)
  selectionCode String   @map("selection_code") @db.VarChar(32)
  line          Decimal? @db.Decimal(4, 1)

  /// Settlement pays on these two columns, never on the current price.
  odds        Decimal @db.Decimal(8, 2)
  oddsVersion Int     @map("odds_version")

  marketLabel    String   @map("market_label") @db.VarChar(64)
  selectionLabel String   @map("selection_label") @db.VarChar(64)
  matchLabel     String   @map("match_label") @db.VarChar(160)
  leagueName     String   @map("league_name") @db.VarChar(120)
  kickoffAt      DateTime @map("kickoff_at") @db.Timestamptz(3)

  outcome SelectionOutcome @default(PENDING)
  result  String?          @db.VarChar(16)

  bet Bet @relation(fields: [betId], references: [id], onDelete: Restrict)

  @@unique([betId, selectionId])
  @@index([matchId, outcome])
  @@index([selectionId])
  @@map("bet_selections")
}

model Ticket {
  id    String @id @default(uuid()) @db.Uuid
  betId String @unique @map("bet_id") @db.Uuid
  code  String @unique @db.VarChar(16)

  shopId      String @map("shop_id") @db.Uuid
  shopCode    String @map("shop_code") @db.VarChar(20)
  cashierId   String @map("cashier_id") @db.Uuid
  cashierName String @map("cashier_name") @db.VarChar(60)

  customerName  String? @map("customer_name") @db.VarChar(80)
  customerPhone String? @map("customer_phone") @db.VarChar(20)

  status TicketStatus @default(OPEN)
  paidAt DateTime?    @map("paid_at") @db.Timestamptz(3)
  paidBy String?      @map("paid_by") @db.Uuid

  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)
  cancelReason String?  @map("cancel_reason") @db.VarChar(160)
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)

  bet Bet @relation(fields: [betId], references: [id], onDelete: Restrict)

  @@index([shopId, createdAt(sort: Desc)])
  @@index([shopId, status])
  @@map("tickets")
}

/// A stake taken for a bet that was never written, held until the wallet confirms its return.
/// `resolution` is RETURNED, or BET_EXISTS when the insert had in fact committed and nothing is owed.
model StakeReturn {
  betId          String    @id @map("bet_id") @db.Uuid
  direction      String    @db.VarChar(8)
  ownerType      String    @map("owner_type") @db.VarChar(16)
  ownerId        String    @map("owner_id") @db.Uuid
  amount         BigInt
  movementType   String    @map("movement_type") @db.VarChar(32)
  reference      String?   @db.VarChar(64)
  actorId        String?   @map("actor_id") @db.Uuid
  idempotencyKey String    @unique @map("idempotency_key") @db.VarChar(200)
  requestId      String    @map("request_id") @db.VarChar(200)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error") @db.VarChar(240)
  nextAttemptAt  DateTime  @map("next_attempt_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(3)
  resolution     String?   @db.VarChar(16)

  @@map("stake_returns")
}
