{
  "name": "@betng/betting-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BetNG betting service — Bet placement, validation, status and the betting lifecycle.",
  "zudojs": {
    "features": [
      "database"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r src/generated dist/generated",
    "clean": "rm -rf dist *.tsbuildinfo",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "cd ../../.. && vitest run apps/services/betting/tests"
  },
  "dependencies": {
    "@betng/contracts": "workspace:*",
    "@betng/service-kit": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@zudojs/container": "1.2.3",
    "@zudojs/cqrs": "1.2.3",
    "@zudojs/database": "1.4.0",
    "@zudojs/errors": "1.3.2",
    "@zudojs/events": "1.3.3",
    "@zudojs/rpc": "1.4.3",
    "@zudojs/validation": "1.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  }
}
