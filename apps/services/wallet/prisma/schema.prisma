// BetNG wallet service schema.
//
// This service owns wallets and the append-only transaction ledger, and nothing else. It connects to `betng_wallet`
// with its own login and holds no credentials for another service's
// database, which is what makes the ownership boundary in
// `docs/architecture.md` enforceable rather than a convention.
//
// Identifiers belonging to another service appear as plain columns rather
// than foreign keys: the referenced table is in a different database, so the
// constraint could not be enforced and pretending otherwise would mislead.
// Referential integrity across services is the API's job.
//
// Prisma 7 no longer takes the connection URL here: migrations read it from
// `prisma.config.ts`, and the client is built with a driver adapter.
// Migrations live in `prisma/migrations`; see `docs/development.md`.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A user's balance.
///
/// Money is stored as an integer count of minor units (kobo) — never a
/// float, and never a type that rounds. `Decimal` would also be correct, but
/// an integer makes it impossible to represent a fraction of a kobo, so the
/// question of how to round one never arises.
model Wallet {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @unique @map("user_id") @db.Uuid

  /// Total holding, in minor units. Constrained non-negative.
  balance  BigInt @default(0)
  /// The part of `balance` committed to bets that have not settled.
  /// Available balance is `balance - reserved`.
  reserved BigInt @default(0)
  /// ISO 4217. Fixed per wallet: a wallet holds one currency, so no
  /// operation can silently add two different ones together.
  currency String @default("NGN") @db.Char(3)

  /// Optimistic-locking counter. Two concurrent debits both read a balance,
  /// both decide it is sufficient, and both write — unless the write is
  /// conditional on the version they read. Incremented on every change.
  version  Int    @default(0)

  /// Blocks all movement without deleting history. A frozen wallet is a
  /// normal state for an account under review, and the ledger must survive
  /// it intact.
  frozenAt DateTime? @map("frozen_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions Transaction[]

  @@map("wallets")
}

/// The kinds of entry the ledger records.
enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  /// Stake moved out of available balance when a bet was accepted.
  BET_STAKE
  /// Winnings credited by the settlement service.
  BET_PAYOUT
  /// Stake returned because a match was cancelled.
  BET_REFUND
  /// Corrects an earlier entry. The ledger is never edited, so a mistake is
  /// fixed by adding the opposite entry and pointing at the original.
  ADJUSTMENT

  @@map("transaction_type")
}

/// One ledger entry.
///
/// The ledger is append-only and is the authority: a balance is the sum of
/// its entries, and `Wallet.balance` is a maintained projection of that sum,
/// not an independent number. There is no update or delete path to this
/// table, so a balance can always be re-derived and audited.
model Transaction {
  id       String          @id @default(uuid()) @db.Uuid
  walletId String          @map("wallet_id") @db.Uuid
  type     TransactionType

  /// Signed: positive credits, negative debits. The sign is on the amount
  /// rather than implied by `type`, so summing the ledger needs no per-type
  /// branching and cannot be got wrong by forgetting a case.
  amount   BigInt
  currency String          @db.Char(3)

  /// The balance immediately after this entry. Stored so an auditor can
  /// verify the running sum without replaying every prior row, and so a
  /// divergence between ledger and projection is detectable.
  balanceAfter BigInt      @map("balance_after")

  /// Caller-supplied key making the write idempotent.
  ///
  /// A retried request — a timeout the client did not see, a redelivered
  /// message — must not credit or debit twice. The unique index makes the
  /// second attempt fail rather than duplicate, which is the difference
  /// between a retry being safe and being a defect.
  idempotencyKey String   @map("idempotency_key") @db.VarChar(120)

  /// The domain object that caused this entry: a bet id for BET_STAKE, a
  /// settlement id for BET_PAYOUT.
  reference      String?  @db.VarChar(120)
  /// For ADJUSTMENT, the entry being corrected.
  correctsId     String?  @map("corrects_id") @db.Uuid

  createdAt DateTime      @default(now()) @map("created_at")

  wallet Wallet @relation(fields: [walletId], references: [id])

  /// Scoped to the wallet rather than global: two users may legitimately
  /// submit the same client-generated key.
  @@unique([walletId, idempotencyKey])
  @@index([walletId, createdAt])
  @@index([reference])
  @@map("transactions")
}
