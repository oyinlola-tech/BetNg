{
  "name": "@betng/event-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BetNG event service — delivers live match events to web, mobile and TV over WebSocket.",
  "zudojs": {
    "features": []
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@betng/contracts": "workspace:*",
    "@betng/service-kit": "workspace:*",
    "@zudojs/adapters": "1.2.0",
    "@zudojs/container": "1.1.2",
    "@zudojs/cqrs": "1.1.1",
    "@zudojs/errors": "1.2.0",
    "@zudojs/rpc": "1.3.0",
    "@zudojs/validation": "1.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "ws": "^8.18.3"
  }
}
